# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vedlogistics

# JWT secret for authentication
JWT_SECRET=change-me-to-a-safe-value

# Email configuration for notifications
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your-email-password

# Address to receive daily reports
NOTIFICATION_EMAIL=officedata01@gmail.com

# Disable automatic daily summary emails in local development
DISABLE_DAILY_SUMMARY=true

# Server port
PORT=4000

# Internal API port for single-container deployments
API_INTERNAL_PORT=4000

# Frontend API base URL
NEXT_PUBLIC_API_URL=/api
